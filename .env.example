# ---------------------------------------------------------------------------
# BudgetFriendly — environment variables
# Copy to .env for local dev:  cp .env.example .env
# On Dokku:  dokku config:set budgetfriendly KEY=value
# ---------------------------------------------------------------------------

# --- Core ------------------------------------------------------------------
# Injected automatically by Dokku when you run:
#   dokku postgres:link budgetfriendly-db budgetfriendly
DATABASE_URL=postgres://postgres:postgres@localhost:5432/budgetfriendly

# Set to "require" if your Postgres needs TLS (managed providers).
# Leave unset/empty for a Dokku-linked Postgres on the internal network.
PGSSLMODE=

PORT=3000

# Reverse proxies in front of the app, so req.ip is the real client.
#   1 = Dokku nginx alone   2 = Dokku nginx behind a tunnel (Tailscale, Cloudflare)
TRUST_PROXY=1
NODE_ENV=development

# --- Auth ------------------------------------------------------------------
# Signs the session cookie. Generate with:  openssl rand -hex 32
SESSION_SECRET=change-me-openssl-rand-hex-32

# Days a login session stays valid.
SESSION_TTL_DAYS=30

# The single user. On first boot, if no user exists, this account is created.
# After the first boot you may unset ADMIN_PASSWORD; the hash lives in the DB.
# There is no public signup route.
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=change-me-before-first-boot

# --- Encryption ------------------------------------------------------------
# AES-256-GCM key for bank credentials stored at rest (OFX Direct Connect).
# MUST be 64 hex chars.  Generate with:  openssl rand -hex 32
# Changing this makes existing stored bank credentials unreadable.
ENCRYPTION_KEY=change-me-openssl-rand-hex-32

# --- Bank connection: OFX Direct Connect -----------------------------------
# Used by the "ofx" import adapter. Look your institution's values up at
# https://www.ofxhome.com/ or ask Golden 1 for their Direct Connect / Quicken
# settings. Verify these before trusting them — see README "OFX Direct Connect".
OFX_URL=
OFX_FI_ORG=
OFX_FI_ID=
OFX_BANK_ID=
OFX_APP_ID=QWIN
OFX_APP_VER=2700
OFX_VERSION=103
# Days of history to request on each sync.
OFX_SYNC_DAYS=90

# --- Bank connection: web automation adapter (optional, off by default) -----
# See src/services/importers/web.js. Requires you to supply the automation
# implementation; nothing here is enabled unless you set this to "true".
WEB_ADAPTER_ENABLED=false

# --- Uploads ---------------------------------------------------------------
# Max size (bytes) for a CSV/OFX/QFX statement upload. Default 10 MB.
MAX_UPLOAD_BYTES=10485760
